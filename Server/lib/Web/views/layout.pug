include module

- if(LANG == undefined) LANG = locals.locale;

doctype html
html
	head
		block Subject
		meta(charset='utf-8')
		meta(name='viewport', content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no')
		script(type='text/javascript').
			function getObject(v, i) {
				Object.defineProperty(v, i, {value: v[i], writable: false});
			}
			getObject(window.WebSocket, "send");
			getObject(window.WebSocket, "onmessage");
			getObject(window, "WebSocket");

		block Search
			meta(name='description', content=LANG['meta_desc'] || L('META_DESC'))
			meta(name='keywords', content=LANG['meta_keys'] || L('META_KEYS'))

		block OpenGraph
			meta(property='og:image', content=locals.ogImage || "http://JJo.kr/img/ogImage.png")
			meta(property='og:url', content=locals.ogURL || "http://JJo.kr/")
			meta(property='og:title', content=locals.ogTitle || "쪼롤 - League of Legends 정보 검색 사이트")
			meta(property='og:description', content=locals.ogDescription || "롤 전적검색은 JJO.KR")

		//- Google Analytics
		script(async, src='https://www.googletagmanager.com/gtag/js?id=G-KJ151B7SHY')
		script.
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-KJ151B7SHY');

		+PageHead()
			block Preload
		block CSS
		block JS

	body(style='min-width: 640px;')
		script.
			try{var __s=JSON.parse(localStorage.getItem('kkutu_volume')||'{}');var __t=__s.theme;if(__t==='red')document.body.classList.add('theme-red');else if(__t==='orange')document.body.classList.add('theme-orange');else if(__t==='gray')document.body.classList.add('theme-gray');else if(__t==='yellow')document.body.classList.add('theme-yellow');else if(__t==='green')document.body.classList.add('theme-green');var __dm=__s.darkMode;if(__dm==='dark'||(__dm==='system'&&window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches))document.body.classList.add('dark-mode');}catch(e){}
		div#Top
			+Menu()
			div#global-notice
				div#gn-content
					if activeEventNotice
						| !{activeEventNotice}
					else
						include ../public/global_notice.html
				+Expl(L('GLOBAL_NOTICE'))
			block Top
		div#Jungle
			span#mobile= locals.mobile
			span#summonerID= DATA._id
			img#Background(src='/img/bg/' + (locals.bg || 'def.png'))
			block Jungle
		div#Middle
			block Middle
		div#Bottom
			block Bottom
			div.bottom-legal
				if locals.as_pc
					a(href='?')= L('AS_MOBILE')
				br
				a.bottom-contact(href='https://discord.gg/z6TZgyTZUj', target='_blank')= '디스코드'
				a.bottom-contact(href='mailto:kitt3n69420@gmail.com', target='_blank')= '이메일 문의'
				br
				a.bottom-contact(href='/legal/privacy', target='_blank')= '개인정보처리방침'
				a.bottom-contact(href='/legal/terms', target='_blank')= '이용약관'
				a.bottom-contact(href='/legal/copyright', target='_blank')= '저작권 안내'
				a.bottom-contact(href='/legal/punishment', target='_blank')= '처벌 내역'
			div.bottom-legal!= L('GPL')
			+separator(10)