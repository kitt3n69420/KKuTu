extends layout

block Subject
	title= L('title')

block CSS
	- var v = locals.appVersion || '1.0.0'
	link(rel='stylesheet', href='/css/in_game_kkutu.css?v=' + v)
	link(rel='stylesheet', href='/css/in_portal.css?v=' + v)

block Middle
	+separator(5)
	div(style='float: left; width: 100%;')
		div(style='float: left; padding-left: 70px;')
			h3#holder= L('title').replace(/\[.+?\]/g, "")
			img#logo(src='/img/kkutu/short_logo.png')
		div#menu-bar(style='float: right; margin-top: 119px; margin-bottom: -50px; width: 432px; display: flex; flex-wrap: wrap; position: relative;')
			a(href='/legal/terms', target='_blank', style='background-color: #3E9C5C;')= L('terms')
			a(href='/legal/privacy', target='_blank', style='background-color: #3E7BC4;')= L('privacy')
			a(href='/legal/operation', target='_blank', style='background-color: #C4823E;')= L('operation')
			a(href='/legal/punishment', target='_blank', style='background-color: #C43E3E;')= L('punishment')
			a(href='/legal/copyright', target='_blank', style='background-color: #7B5FC4;')= L('copyright')
			a(href='/legal/word-sources', target='_blank', style='background-color: #4CAF93;')= L('wordSources')
			a(href='/kkutu_bulletin.html', target='_blank', style='background-color: #C4B23E;')= L('updateLog')
			a(href='https://discord.gg/z6TZgyTZUj', target='_blank', style='background-color: #5865F2;')= L('DISCORD')
			if activeEventBanner
				a#event-banner(href=activeEventBanner.link, target='_blank')
					img(src=activeEventBanner.image, alt='이벤트 배너')
		div.jjoriping(style='margin-top: 40px;')
			img.jjoObj.jjoEyeL(src='/img/jjoeyeL.png', style='left: -270px;')
			img.jjoObj.jjoNose(src='/img/jjonose.png', style='left: -170px;')
			img.jjoObj.jjoEyeR(src='/img/jjoeyeR.png', style='left: -70px;')
			div.jjoDisplayBar(style='width: 325px; height: 85px;')
				button#game-start.jjo-display(data-guest-blocked=(!SESSION.profile && locals.GUEST_CONNECT_ALLOWED === false))= (!SESSION.profile && locals.GUEST_CONNECT_ALLOWED === false) ? L('loginToStart') : L('gameStart')
	div(style='float: right; margin-top: -120px; width: 50%;')
		div.server-list-box
			h3.server-list-title
				a#server-refresh
					+FA('refresh')
					+Expl(L('serverRefresh'))
				label= L('serverList')
				label#server-total(style='color: #AAA; font-size: 13px;')
			div#server-list
	div(style='float: left; width: calc(100% - 4px); border: 2px solid #CCC; margin-top: 10px; background-color: #EEE;')
		iframe#kkutu-bulletin(width='100%', height='400px', src='/kkutu_bulletin.html')
	+separator(10)

block Bottom
	div.bottom-legal!= L('dictionarySupport')
	div.bottom-legal!= L('etcSupport')