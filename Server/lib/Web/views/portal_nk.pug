//- 신형 포탈 — 신 UI를 고른 사람만 보임(nk_portal.css가 html[data-ui="new"]일 때만 #nk-portal을 보이고 기존 포탈을 숨김).
//- 시안: nk_mockups/portal (G2 배치 + P2 글자 타일 무늬). 동작은 lib/in_portal.js의 "신형 포탈" 부분.
//- 대표 모드 카드: 이 목록만 고치면 됨. [모드 코드(언어 키 npMode~/npModeDesc~), 도움말(/help) 항목 id(help.pug의 li#…)]
- var NP_MODES = [['KSH', 'c3p5'], ['KKT', 'c3p4'], ['KDA', 'c3p59'], ['CSQ', 'c3p20'], ['KQZ', 'c3p28'], ['KFR', 'c3p63'], ['KRT', 'c3p72'], ['CNC', 'c3p68']]
//- 설정 창의 테마 (theme-engine.js PRESETS 순서, 이름은 기존 언어 키 theme~). 커스텀은 게임에서 만든 것이 있을 때만 보임
- var NP_THEMES = [['blue', 'Blue'], ['grape', 'Grape'], ['green', 'Green'], ['yellow', 'Yellow'], ['orange', 'Orange'], ['red', 'Red'], ['gray', 'Gray'], ['slate', 'Slate'], ['watermelon', 'Watermelon'], ['sweetpotato', 'Sweetpotato'], ['cottoncandy', 'Cottoncandy'], ['custom', 'Custom']]
//- 바탕 글자 타일: [글자, 왼쪽 %, 위 %, 크기 px, 기울기, 진하기, 강조]. 글을 가리지 않게 위·아래 띠와 오른쪽 끝에만 둠
- var NP_TILES = [['잇', 80, 4, 72, 8, .9], ['기', 90, 13, 52, -10, .7], ['말', 68, 9, 42, -6, .5], ['끝', 50, 3, 38, 10, .35], ['차', 93, 34, 46, 12, .5, 1], ['표', 94, 56, 42, -14, .45], ['범', 86, 82, 68, -8, .85, 1], ['인', 74, 89, 46, 14, .55], ['간', 58, 85, 50, -12, .45], ['장', 40, 90, 40, 8, .35], ['수', 24, 86, 44, -6, .3]]
- var NP_ICONS = ['KSH', 'KKT', 'KDA', 'CSQ', 'KQZ', 'KFR', 'KRT', 'CNC']
- var npEv = locals.activeEventBanner
- var npBlocked = !SESSION.profile && locals.GUEST_CONNECT_ALLOWED === false
- function npZp(n) { return (n < 10 ? '0' : '') + n; }
//- 남은 날: 끝나는 날까지 D-n, 마지막 날은 D-DAY. 1970년이면 해마다 같은 날짜(올해, 이미 지났으면 내년 — 해넘김 이벤트)
- function npDday(t) { var e = new Date(t), now = new Date(), today = new Date(now.getFullYear(), now.getMonth(), now.getDate()); if (e.getFullYear() === 1970) { e.setFullYear(now.getFullYear()); if (e < today) e.setFullYear(now.getFullYear() + 1); } var n = Math.round((new Date(e.getFullYear(), e.getMonth(), e.getDate()) - today) / 86400000); return n > 0 ? 'D-' + n : 'D-DAY'; }
- function npDate(t) { var d = new Date(t); return (d.getFullYear() === 1970 ? '' : d.getFullYear() + '.') + npZp(d.getMonth() + 1) + '.' + npZp(d.getDate()); }
