//- 모드 카드 묶음·게임 시작 묶음 — 데스크톱과 휴대폰이 놓는 자리만 다름
mixin npModes()
	div.np-modes
		each m in NP_MODES
			button.np-mode(type='button', data-help=m[1])
				div.np-mode-ic
					if NP_ICONS.indexOf(m[0]) !== -1
						svg.np-i
							use(href='#np-m-' + m[0])
					else
						= L('npMode' + m[0]).charAt(0)
				div.np-mode-name= L('npMode' + m[0])
				div.np-mode-desc= L('npModeDesc' + m[0])
	button#np-modes-all.np-textbtn(type='button')
		| #{L('npModesAll')}
		+npI('right')
mixin npStart()
	button#np-start(type='button', disabled)
		+npI('play')
		div= npBlocked ? L('loginToStart') : L('gameStart')
	div.np-row2
		button#np-account.np-btn.tint(type='button')
			+npI('user')
			div.np-ellipsis= SESSION.profile ? (SESSION.profile.title || SESSION.profile.name) : L('LOGIN')
		a.np-btn(href='#help')
			+npI('help')
			div= L('npHelpFirst')

//- 휴대폰(m_portal.pug가 npPhone = true로 include, 시안 nk_mockups/m_portal C): 첫 화면(.np-intro)은 화면 높이 가득 로고·소개·게임 시작만,
//- 내리면 이벤트·소식(.np-play) → 모드 카드(.np-pmodes) → 아래 칸. 배치는 nk_portal.css 7) 휴대폰
div#nk-portal(data-me=SESSION.profile ? SESSION.profile.id : '', data-nick-limit=JSON.stringify(locals.NICKNAME_LIMIT || {}))
	//- 위쪽 전체 공지 — 내용은 기존 틀의 #gn-content(손님 차단·이벤트·global_notice.html)를 in_portal.js가 옮김. 내용이 없으면 안 보임
	div.np-notice#np-notice
		div.np-notice-label= L('nkNotice')
		div.np-notice-text#np-notice-text
		button.np-notice-close#np-notice-close(type='button', title=L('npClose'))
			+npI('close')
	div.np-hero
		div.np-intro
			div.np-deco(aria-hidden='true')
				each t in NP_TILES
					- var npTileStyle = 'left:' + t[1] + '%;top:' + t[2] + '%;width:' + t[3] + 'px;height:' + t[3] + 'px;font-size:' + Math.round(t[3] * 0.5) + 'px;transform:rotate(' + t[4] + 'deg);opacity:' + t[5]
					div(class='np-tile' + (t[6] ? ' hl' : ''), style=npTileStyle)= t[0]
			a.np-logo(href='/') 끄투#[b 엔]
			div.np-intro-body
				h1.np-title
					= L('npSlogan1') + ' '
					em= L('npSlogan2')
				div.np-lead= L('npLead')
				if npPhone
					div.np-pgo
						+npStart()
					div.np-pmore(aria-hidden='true')
						div= L('npScrollMore')
						+npI('down')
				else
					+npModes()
		div.np-play
			button#np-set-open.np-btn.np-play-set(type='button')
				+npI('gear')
				div= L('nkSettings')
			div.np-go
				unless npPhone
					div.np-go-title= L('npPlayTitle')
					div.np-go-hint= npBlocked ? L('npPlayHintLogin') : (SESSION.profile ? L('npPlayHintMe', SESSION.profile.title || SESSION.profile.name) : L('npPlayHint'))
					+npStart()
					div.np-sep
				if npEv
					a.np-evbar(href=npEv.link, target='_blank')
						img(src=npEv.image, alt='')
						div.np-evbar-body
							div.np-chip.solid= L('npEventChip') + ' · ' + npDday(npEv.end)
							div.np-evbar-title!= activeEventNotice || L('npEventDefault')
							div.np-evbar-sub= L('npUntil', npDate(npEv.end))
						+npI('right')
				a#np-latest.np-latest(href='#updates', style='display: none;')
					div.np-ic
						+npI('news')
					div.np-latest-body
						div#np-latest-title
						div#np-latest-sub
					+npI('right')
				a.np-btn.np-discord(href='https://discord.gg/z6TZgyTZUj', target='_blank')
					+npI('chat')
					div= L('npDiscord')
		if npPhone
			div.np-pmodes
				h2
					+npI('play')
					div= L('npModesTitle')
				+npModes()
	div.np-board
		div.np-grid
			section.np-card#np-upd
				div.np-head
					h2
						+npI('news')
						div= L('npUpdates')
					a.np-head-more(href='#updates')
						| #{L('npViewAll')}
						+npI('right')
				div.np-tabs#np-upd-tabs
					button.on(type='button', data-tab='updates')= L('npUpdTabLog')
					button(type='button', data-tab='issues')= L('npUpdTabIssues')
					button(type='button', data-tab='plans')= L('npUpdTabPlans')
				div#np-upd-body
					div.np-msg= L('npLoading')
			section.np-card#np-rank
				div.np-head
					h2
						+npI('trophy')
						div= L('nkRank')
					button#np-rank-all.np-head-more(type='button')
						| #{L('npRankAll')}
						+npI('right')
				div.np-tabs.np-rank-tabs
					button.on(type='button', data-type='exp')= L('npRankExp')
					button(type='button', data-type='ksh')= L('npRankKsh')
					button(type='button', data-type='money')= L('npRankMoney')
				div#np-rank-list.np-rank-list
					div.np-msg= L('npLoading')
			section.np-card#np-event
				div.np-head
					h2
						+npI('cal')
						div= L('npEvents')
				if npEv
					a.np-ev(href=npEv.link, target='_blank')
						img(src=npEv.image, alt='')
						div.np-ev-body
							div.np-chip.solid= L('npEventLive') + ' · ' + npDday(npEv.end)
							div.np-ev-title!= activeEventNotice || L('npEventDefault')
							div.np-ev-date= npDate(npEv.start) + ' ~ ' + npDate(npEv.end)
							div.np-btn.primary= L('npEventMore')
				else
					div.np-empty
						div= L('npEventNone')
						div.np-empty-sub= L('npEventNoneSub')
		div.np-links
			a.np-link(href='#help')
				div.np-ic
					+npI('help')
				div
					div.np-link-name= L('npLinkHelp')
					div.np-link-sub= L('npLinkHelpDesc')
			a.np-link(href='https://kkutu.site', target='_blank')
				div.np-ic
					+npI('server')
				div
					div.np-link-name= L('npLinkServers')
					div.np-link-sub kkutu.site
			a.np-link(href='https://github.com/kitt3n69420/KKuTu', target='_blank')
				div.np-ic
					+npI('code')
				div
					div.np-link-name= L('npLinkCode')
					div.np-link-sub GitHub
		div.np-foot
			div.np-legal
				a(href='/legal/terms', target='_blank')= L('terms')
				a.hl(href='/legal/privacy', target='_blank')= L('privacy')
				a(href='/legal/operation', target='_blank')= L('operation')
				a(href='/legal/punishment', target='_blank')= L('punishment')
				a(href='/legal/copyright', target='_blank')= L('copyright')
				a(href='/legal/word-sources', target='_blank')= L('wordSources')
				a(href='mailto:kitt3n69420@gmail.com', target='_blank')= L('npContact')
			div.np-credit!= L('dictionarySupport')
			div.np-credit!= L('etcSupport')
			div.np-credit!= L('GPL')
	//- 전체 랭킹 화면 (#ranking) — 첫 화면·아래 칸 대신 보임
	div#np-rank-page
		div.np-page-head
			a.np-logo(href='/') 끄투#[b 엔]
			button.np-btn.np-view-back(type='button')
				+npI('left')
				div= L('npBack')
		div.np-card.np-rank-card
			div.np-head
				h2
					+npI('trophy')
					div= L('nkRank')
				div.np-tabs.np-rank-tabs
					button.on(type='button', data-type='exp')= L('npRankExp')
					button(type='button', data-type='ksh')= L('npRankKsh')
					button(type='button', data-type='money')= L('npRankMoney')
				button#np-rank-mine.np-btn(type='button', disabled=!SESSION.profile)= L('npRankMe')
			div#np-rank-full.np-rank-list
			div.np-pager
				button#np-rank-prev.np-btn(type='button')
					+npI('left')
				div#np-rank-pg
				button#np-rank-next.np-btn(type='button')
					+npI('right')
	//- 업데이트 로그 화면 (#updates) — kkutu_bulletin.html의 목차(칸 3개)를 탭으로, 내용 전체를 신 UI 모양으로
	div#np-updp-page
		div.np-page-head
			a.np-logo(href='/') 끄투#[b 엔]
			button.np-btn.np-view-back(type='button')
				+npI('left')
				div= L('npBack')
		div.np-card.np-updp-card
			div.np-head
				h2
					+npI('news')
					div= L('npUpdates')
				div.np-tabs#np-updp-tabs
					button.on(type='button', data-tab='updates')= L('npUpdTabLog')
					button(type='button', data-tab='issues')= L('npUpdTabIssues')
					button(type='button', data-tab='plans')= L('npUpdTabPlans')
			div#np-updp-body
				div.np-msg= L('npLoading')
	//- 도움말 화면 (#help) — 신 UI 로비 도움말(kkutu_nk.pug #nk-page-help)과 같은 모양: 왼쪽 목차·검색 | 오른쪽 본문·이전/다음
	div#np-help-page
		div.np-page-head
			a.np-logo(href='/') 끄투#[b 엔]
			button.np-btn.np-view-back(type='button')
				+npI('left')
				div= L('npBack')
		div.np-card.np-help-card
			div.np-head
				h2
					+npI('help')
					div= L('nkHelp')
				label.np-search
					+npI('search')
					input#np-help-q(type='text', maxlength='30', placeholder=L('nkHelpSearch'))
			div.np-help-body
				nav#np-help-nav
					div.np-msg= L('nkHelpLoading')
				div.np-help-main
					div#np-help-crumb
					div#np-help-title
					div#np-help-doc.np-help
					div.np-help-foot
						button#np-help-prev.np-btn(type='button')
							+npI('left')
							div#np-help-prev-t
						button#np-help-next.np-btn(type='button')
							div#np-help-next-t
							+npI('right')
	//- 설정 창 — 게임 설정 중 테마·밝기·언어·UI만. 저장은 게임과 같은 localStorage(kkutu_volume, kkutu_lang)
	div#np-set.np-overlay
		div.np-dlg
			div.np-dlg-head
				div.np-dlg-title= L('nkSettings')
				button#np-set-close.np-iconbtn(type='button', title=L('npClose'))
					+npI('close')
			div.np-dlg-body
				div.np-set-row
					div.np-set-label= L('theme')
					div.np-swatches#np-set-theme
						each t in NP_THEMES
							button.np-swatch(type='button', data-v=t[0])
								div.np-swatch-dot
								div= L('theme' + t[1])
					button#np-theme-edit.np-btn.np-set-more(type='button')
						+npI('pen')
						div= L('npThemeEdit')
				div.np-set-row
					div.np-set-label= L('darkMode')
					div.np-tabs#np-set-dark
						button(type='button', data-v='light')= L('darkModeLight')
						button(type='button', data-v='dark')= L('darkModeDark')
						button(type='button', data-v='system')= L('darkModeSystem')
				div.np-set-row
					div.np-set-label= L('language')
					div.np-tabs#np-set-lang
						button(type='button', data-v='ko_KR') 한국어
						button(type='button', data-v='en_US') English
						button(type='button', data-v='ja_JP') 日本語
						button(type='button', data-v='nya') ???
				div.np-set-row
					div.np-set-label= L('uiSetting')
					button#np-set-classic.np-btn.np-set-act(type='button')
						+npI('left')
						div= L('npToClassic')
					div.np-set-hint= L('npReloadHint')
				if SESSION.profile
					div.np-set-row
						div.np-set-label= L('npAccount')
						button#np-set-logout.np-btn.np-set-act(type='button')
							+npI('user')
							div= L('nkLogout')
	//- 커스텀 테마 편집 창 — 게임의 ThemeDiag와 같은 값(강조·메인·밝은·어두운 색, 테마 코드), 저장도 같은 곳(kkutu_volume theme: 'custom', customTheme)
	div#np-theme.np-overlay
		div.np-dlg
			div.np-dlg-head
				div.np-dlg-title= L('themeEditorTitle')
				button#np-theme-close.np-iconbtn(type='button', title=L('npClose'))
					+npI('close')
			div.np-dlg-body
				div.np-tprev
					each pv in [['light', 'darkModeLight'], ['dark', 'darkModeDark']]
						div.np-tprev-box(id='np-tprev-' + pv[0], class='np-tprev-' + pv[0])
							div.np-tprev-label= L(pv[1])
							div.np-tprev-card
								div.np-tprev-top
									div.np-tprev-logo 끄투#[b 엔]
									div.np-tprev-chip= L('npThemePrevChip')
								div.np-tprev-text= L('npThemePrevText')
								div.np-tprev-btn= L('npThemePrevBtn')
				div.np-set-row
					div.np-set-label= L('themePreset')
					div.np-swatches.np-swatches-sm#np-theme-preset
						each t in NP_THEMES
							if t[0] !== 'custom'
								button.np-swatch(type='button', data-v=t[0])
									div.np-swatch-dot
									div= L('theme' + t[1])
				div.np-tcolors
					each c in [['primary', 'themeColorPrimary'], ['medium', 'themeColorMedium'], ['lightBase', 'themeColorLight'], ['darkBase', 'themeColorDark']]
						div.np-tcolor
							div.np-set-label= L(c[1])
							div.np-tcolor-in
								input.np-color(type='color', data-k=c[0])
								input.np-input(type='text', maxlength='7', spellcheck='false', data-k=c[0])
				div.np-set-row
					div.np-set-label= L('themeCode')
					div.np-tcode
						input#np-theme-code.np-input(type='text', spellcheck='false')
						button#np-theme-copy.np-btn(type='button')= L('themeCodeCopy')
					div.np-set-hint= L('npThemeCodeHint')
				div#np-theme-warn.np-warn= L('themeContrastWarning')
				div.np-set-hint= L('themeResetHint')
			div.np-dlg-foot
				button#np-theme-cancel.np-btn(type='button')= L('NO')
				button#np-theme-ok.np-btn.primary(type='button')= L('OK')
	//- 내 프로필 창 (로그인했을 때 계정 단추) — 별명·소개말은 게임과 같은 POST /profile, 지금 값은 GET /profile/me
	div#np-prof.np-overlay
		div.np-dlg
			div.np-dlg-head
				div.np-dlg-title= L('nkMyProfile')
				button#np-prof-close.np-iconbtn(type='button', title=L('npClose'))
					+npI('close')
			div.np-dlg-body
				label.np-field
					div.np-set-label= L('myNickname')
					input#np-prof-nick.np-input(type='text', maxlength='12', placeholder=L('myNicknameX'))
				label.np-field
					div.np-set-label= L('myExordial')
					input#np-prof-exor.np-input(type='text', maxlength='100', placeholder=L('myExordialX'))
			div.np-dlg-foot
				button#np-prof-logout.np-btn.danger(type='button')= L('nkLogout')
				button#np-prof-cancel.np-btn(type='button')= L('NO')
				button#np-prof-ok.np-btn.primary(type='button')= L('OK')
	//- 알림·확인 (포탈 안 작은 창)
	div#np-msg.np-overlay
		div.np-dlg.np-dlg-sm
			div.np-dlg-body
				div#np-msg-text
			div.np-dlg-foot
				button#np-msg-no.np-btn(type='button')= L('NO')
				button#np-msg-ok.np-btn.primary(type='button')= L('OK')
	//- 게임 모드 설명 창 — 도움말(/help)의 "게임 모드" 항목을 가져와 보여 줌(도움말로 이동하지 않음)
	div#np-modal
		div.np-modal-box
			div#np-modal-nav
			div.np-modal-main
				div.np-modal-head
					div#np-modal-crumb
					div#np-modal-title
					button#np-modal-close.np-iconbtn(type='button', title=L('npClose'))
						+npI('close')
				div#np-modal-body.np-help
