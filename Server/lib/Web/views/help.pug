extends ./ext

mixin Img(name, w, h)
	- var path = "/img/kkutu/help/" + name + ".png";
	- if(h)
		img(src=path, width=w, height=h)
	- else
		img(src=path)

block JS
	- var v = locals.appVersion || '1.0.0'
	script(type='text/javascript', src='/js/jquery.js?v=' + v)
	script(type='text/javascript', src='/js/in_game_kkutu_help.min.js?v=' + v)
	script.
		$(function() {
			try {
				var settings = JSON.parse(localStorage.getItem("kkutu_volume")) || {};
				var levelPack = settings.levelPack;
				if (levelPack) {
					var url = "/img/kkutu/lv/" + levelPack + ".png";
					$("#box-c5p2 tbody div").each(function() {
						var bg = $(this).css("background-image");
						if (bg && bg.indexOf("newlv.png") !== -1) {
							$(this).css("background-image", "url('" + url + "')");
						}
					});
				}
				var darkMode = settings.darkMode || 'light';
				if (darkMode === 'dark' || (darkMode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.body.classList.add('dark-mode');
				}
				var theme = settings.theme || '';
				if (theme) document.body.classList.add('theme-' + theme);
			} catch(e) {}
		});

block CSS
	link(rel='stylesheet', href='/css/in_game_kkutu_help.css?v=' + v)

