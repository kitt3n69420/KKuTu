			table#box-exp-table
				-
					function getRequiredScore(lv){
						return Math.round(
							(!(lv%5)*0.3 + 1) * (!(lv%15)*0.4 + 1) * (!(lv%45)*0.5 + 1) * (
								120 + Math.floor(lv/5)*60 + Math.floor(lv*lv/225)*120 + Math.floor(lv*lv/2025)*180
							)
						);
					}
				thead: tr
					td(style='width: 40px;') 계급장
					td 레벨
					td 필요 경험치
					td 총 경험치
				tbody(style='text-align: center;')
					- var MAX_LEVEL = 360;
					- var curr, integ = 0;
					- for(var lv=1; lv<=MAX_LEVEL; lv++)
						- var lIdx = lv - 1;
						- var lX = (lIdx % 25) * -100;
						- var lY = Math.floor(lIdx * 0.04) * -100;
						tr
							td: div(style=`width: 40px; height: 40px; background-image: url('/img/kkutu/lv/newlv.png'); background-position: ${lX}% ${lY}%; background-size: 2560%; margin: 0 auto;`)
							td= lv
							td= curr = (lv == MAX_LEVEL) ? "-" : getRequiredScore(lv)
							td= (lv == MAX_LEVEL) ? "-" : integ += curr
