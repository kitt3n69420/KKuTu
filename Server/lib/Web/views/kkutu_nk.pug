div#nk-app
	header.nk-header
		//- 글자 로고(페이퍼로지): "끄투"는 글자색, "엔"은 메인 색. 누르면 사이트 홈
		a.nk-logo#nk-logo(href='/', title=L('HOME'))
			div.nk-logo-a 끄투
			div.nk-logo-b 엔
		//- 게임 중에만 보이는 방 정보 (nk.js renderGameHead). 나가기·아이템 줄도 게임 중에는 이 뒤로 옮겨 옴
		div.nk-gamehead#nk-gamehead
		nav.nk-nav#nk-nav
		//- 오른쪽 묶음: 게임 중에는 나가기·아이템 줄이 계정 앞으로 들어옴 (방 정보를 가운데에 두려고 로고와 같은 폭 규칙을 씀)
		div.nk-head-end#nk-head-end
			//- 리플레이 중에만: 진행 시간과 ← ❚❚ → 단추 (기존 리플레이 조작 요소를 nk.js setReplay가 옮겨 옴)
			div.nk-replay#nk-replay
			button.nk-account#nk-account(type='button')
	div.nk-notice#nk-notice
		div.nk-notice-label(data-lang-key='nkNotice')= L('nkNotice')
		div.nk-notice-text#nk-notice-text
		button.nk-icon-btn#nk-notice-close(type='button')
			svg.nk-i
				use(href='#nk-i-x')
	div.nk-main
		section.nk-center#nk-center
			div.nk-actionbar#nk-actionbar
				div.nk-actions#nk-actions
			div.nk-center-body#nk-center-body
				//- 로비 가운데 화면(nk.js 가운데 화면): 상점처럼 방 목록 자리를 차지함
				//- 랭킹: 기존 랭킹 창의 탭·표·페이지 단추를 nk.js가 옮겨 옴 (불러오기·그리기는 기존 drawLeaderboard)
				div.nk-panel.nk-page#nk-page-rank(data-page='rank', style='display: none;')
					div.nk-panel-head
						div.nk-panel-title
							label(data-lang-key='nkRank')= L('nkRank')
						div.nk-spacer
						div.nk-seg#nk-rank-tabs
					div.nk-rank-body.nk-scroll#nk-rank-body
					div.nk-panel-head.nk-rank-foot#nk-rank-foot
				//- 도움말 (로비 전체 화면): 왼쪽 목차(섹션) + 오른쪽 본문. 내용은 기존 도움말 페이지(/help)를 처음 열 때 불러와 nk.js가 그림.
				//- 방·게임에서는 기존 도움말 창
				div.nk-panel.nk-page#nk-page-help(data-page='help', style='display: none;')
					div.nk-panel-head
						div.nk-panel-title
							label(data-lang-key='nkHelp')= L('nkHelp')
						div.nk-spacer
						label.nk-search.nk-help-q
							svg.nk-i
								use(href='#nk-i-search')
							input.nk-input#nk-help-q(type='text', maxlength='30', placeholder=L('nkHelpSearch'))
						//- 휴대폰: 본문이 화면 전체를 쓰고 목차·검색은 이 단추로 여는 시트 (데스크톱에서는 숨김)
						button.nk-btn.nk-help-toc#nk-help-toc(type='button')
							svg.nk-i
								use(href='#nk-i-list')
							label(data-lang-key='nkHelpToc')= L('nkHelpToc')
					div.nk-help-body
						nav.nk-help-nav.nk-scroll#nk-help-nav
						div.nk-help-main
							div.nk-help-crumb#nk-help-crumb
							div.nk-help-title#nk-help-title
							div.nk-help-page.nk-scroll#nk-help-page
							div.nk-help-foot
								button.nk-btn#nk-help-prev(type='button')
									svg.nk-i
										use(href='#nk-i-back')
									label#nk-help-prev-t
								div.nk-spacer
								button.nk-btn#nk-help-next(type='button')
									label#nk-help-next-t
									svg.nk-i
										use(href='#nk-i-next')
				//- 사전: 왼쪽 뜻풀이(기존 /dict), 오른쪽 단어 찾기(/dict-search). 방·게임에서는 기존 사전 창
				div.nk-panel.nk-page#nk-page-dict(data-page='dict', style='display: none;')
					div.nk-panel-head
						div.nk-panel-title
							label(data-lang-key='dict')= L('dict')
						//- 휴대폰: [뜻풀이 | 단어 찾기] 한 번에 하나 (데스크톱은 두 칸이라 숨김)
						div.nk-seg.nk-dict-tabs#nk-dict-tabs
							button.nk-seg-btn(type='button', data-tab='mean')
								label(data-lang-key='nkDictMean')= L('nkDictMean')
							button.nk-seg-btn(type='button', data-tab='find')
								label(data-lang-key='nkDictFind')= L('nkDictFind')
					div.nk-dict-body
						div.nk-dict-mean
							div.nk-dict-label(data-lang-key='nkDictMean')= L('nkDictMean')
							label.nk-search
								svg.nk-i
									use(href='#nk-i-search')
								input.nk-input#nk-dict-word(type='text', maxlength='50', placeholder=L('nkDictWordPh'))
							div.nk-dict-out.nk-scroll#nk-dict-out
								div.nk-dict-empty(data-lang-key='nkDictMeanHint')= L('nkDictMeanHint')
							div.nk-dict-label(data-lang-key='nkDictRecent')= L('nkDictRecent')
							div.nk-dict-recent#nk-dict-recent
						div.nk-dict-find
							div.nk-dict-label(data-lang-key='nkDictFind')= L('nkDictFind')
							div.nk-dict-row
								input.nk-input.nk-dict-char#nk-dict-char(type='text', maxlength='30', placeholder=L('nkDictFirst'))
								div.nk-seg#nk-dict-mode
									button.nk-seg-btn(type='button', data-v='long')
										label(data-lang-key='nkDictLong')= L('nkDictLong')
									button.nk-seg-btn(type='button', data-v='attack')
										label(data-lang-key='nkDictAttack')= L('nkDictAttack')
									button.nk-seg-btn(type='button', data-v='mission')
										label(data-lang-key='nkDictMission')= L('nkDictMission')
								input.nk-input.nk-dict-mis#nk-dict-mis(type='text', maxlength='2', placeholder=L('nkDictMission'))
								button.nk-btn.primary.nk-dict-go#nk-dict-go(type='button')
									svg.nk-i
										use(href='#nk-i-search')
							div.nk-dict-row
								//- 언어는 직접 고르지 않고 넣은 글자로 정함 (nk.js dictDetect)
								div.nk-dict-lang#nk-dict-lang(data-nk-tip=L('nkDictLangTip'))= L('nkDictKo')
								select.nk-select#nk-dict-dir
									option(value='end')= L('nkDictEnd')
									option(value='front')= L('nkDictFront')
								button.nk-chip(type='button', data-opt='manner')
									svg.nk-i.nk-i-on
										use(href='#nk-i-check')
									label(data-lang-key='optManner')= L('optManner')
								button.nk-chip(type='button', data-opt='injeong')
									svg.nk-i.nk-i-on
										use(href='#nk-i-check')
									label(data-lang-key='optInjeong')= L('optInjeong')
								button.nk-chip(type='button', data-opt='allpos')
									svg.nk-i.nk-i-on
										use(href='#nk-i-check')
									label(data-lang-key='optAllpos')= L('optAllpos')
							div.nk-dict-sum#nk-dict-sum
							div.nk-dict-res.nk-scroll
								table.nk-dict-table
									thead
										tr
											td.n #
											td(data-lang-key='nkDictWord')= L('nkDictWord')
											td.m(data-lang-key='nkDictMission')= L('nkDictMission')
											td.e#nk-dict-col-link= L('nkDictLast')
											td.r(data-lang-key='nkDictNext')= L('nkDictNext')
									tbody#nk-dict-list
		aside.nk-side#nk-side
			div.nk-slot#nk-people(data-ptab='users')
				div.nk-panel.nk-people
					div.nk-panel-head
						div.nk-ptabs
							button.nk-ptab#nk-ptab-users(type='button', data-ptab='users')
								svg.nk-i
									use(href='#nk-i-users')
								label(data-lang-key='nkUsers')= L('nkUsers')
								em#nk-users-count
							button.nk-ptab#nk-ptab-friends(type='button', data-ptab='friends')
								svg.nk-i
									use(href='#nk-i-heart')
								label(data-lang-key='nkFriends')= L('nkFriends')
								em#nk-friends-count
					//- nk.js가 기존 .UserListBox를 이 칸 끝으로 옮김
					div.nk-people-body#nk-pbody-users
						div.nk-people-search
							label.nk-search
								svg.nk-i
									use(href='#nk-i-search')
								input.nk-input#nk-user-q(type='text', autocomplete='off', placeholder=L('nkUserSearch'), data-lang-attr-placeholder='nkUserSearch')
					div.nk-people-body#nk-pbody-friends
						div.nk-people-list.nk-scroll#nk-friend-list
						button.nk-btn.ghost.nk-friend-add#nk-friend-add(type='button')
							svg.nk-i
								use(href='#nk-i-userplus')
							label(data-lang-key='friendAdd')= L('friendAdd')
			div.nk-slot#nk-chat
				//- 휴대폰: 로비의 채팅은 아래에서 올라오는 시트 — 닫기 단추 (다른 화면에서는 숨김)
				button.nk-icon-btn.nk-sheet-x#nk-chat-x(type='button')
					svg.nk-i
						use(href='#nk-i-x')
	//- 휴대폰(모바일 화면)에서만 보임 (nk.css 15). 로비 맨 아래 채팅 한 줄 · 아래 탭 · 시트 뒤 어둡게 · 더보기 시트
	button.nk-chatbar#nk-chatbar(type='button')
		svg.nk-i
			use(href='#nk-i-chat')
		div.nk-chatbar-who#nk-chatbar-who
		div.nk-chatbar-text#nk-chatbar-text
		div.nk-chatbar-n#nk-chatbar-n
	nav.nk-tabbar#nk-tabbar
	div.nk-dim#nk-dim
	div.nk-sheet#nk-more-sheet
		div.nk-sheet-head
			div.nk-sheet-title(data-lang-key='nkMore')= L('nkMore')
			button.nk-icon-btn.nk-sheet-x(type='button')
				svg.nk-i
					use(href='#nk-i-x')
		div.nk-sheet-body#nk-more-body
	//- 휴대폰: 공지 한 줄을 누르면 전체 공지
	div.nk-sheet#nk-notice-sheet
		div.nk-sheet-head
			div.nk-sheet-title(data-lang-key='nkNotice')= L('nkNotice')
			button.nk-icon-btn.nk-sheet-x(type='button')
				svg.nk-i
					use(href='#nk-i-x')
		div.nk-sheet-body.nk-notice-body#nk-notice-body
	//- 휴대폰: 도움말 목차 (nk.js가 검색 칸과 목차를 옮겨 담음)
	div.nk-sheet#nk-help-sheet
		div.nk-sheet-head
			div.nk-sheet-title(data-lang-key='nkHelpToc')= L('nkHelpToc')
			button.nk-icon-btn.nk-sheet-x(type='button')
				svg.nk-i
					use(href='#nk-i-x')
		div.nk-sheet-body#nk-help-sheet-body
	//- 기존 패널 안에 끼워 넣을 조각. nk.js가 초기화 때 제자리로 옮김
	div#nk-parts
		div.nk-room-tools#nk-room-tools
			div.nk-panel-head
				div.nk-panel-title
					label(data-lang-key='nkRoomList')= L('nkRoomList')
					div.nk-count#nk-room-count
				div.nk-spacer
				label.nk-search
					svg.nk-i
						use(href='#nk-i-search')
					input.nk-input#nk-room-q(type='text', autocomplete='off', placeholder=L('nkRoomSearch'), data-lang-attr-placeholder='nkRoomSearch')
			div.nk-panel-head.nk-filter-row
				button.nk-chip#nk-f-wait(type='button')
					svg.nk-i.nk-i-on
						use(href='#nk-i-check')
					label(data-lang-key='nkOnlyWaiting')= L('nkOnlyWaiting')
				button.nk-chip#nk-f-open(type='button')
					svg.nk-i.nk-i-on
						use(href='#nk-i-check')
					label(data-lang-key='nkOnlyOpen')= L('nkOnlyOpen')
				div.nk-vsep
				div.nk-seg#nk-f-cat
				div.nk-spacer
				select.nk-select#nk-f-sort
					option(value='id', data-lang-key='nkSortDefault')= L('nkSortDefault')
					option(value='open', data-lang-key='nkSortOpen')= L('nkSortOpen')
					option(value='players', data-lang-key='nkSortPlayers')= L('nkSortPlayers')
		//- 상점 머리: 기존 #shop-search 입력창과 .shop-categories를 nk.js가 이 안으로 옮김
		div.nk-shop-tools#nk-shop-tools
			div.nk-panel-head
				div.nk-panel-title
					label(data-lang-key='shop')= L('shop')
					div.nk-count#nk-shop-count
				div.nk-spacer
				label.nk-search#nk-shop-search
					svg.nk-i
						use(href='#nk-i-search')
				div.nk-tag.mode#nk-shop-money
			div.nk-panel-head.nk-filter-row#nk-shop-cats
		div.nk-empty#nk-rooms-empty
			div.nk-empty-title#nk-rooms-empty-title
			div#nk-rooms-empty-sub
			button.nk-btn#nk-rooms-empty-btn(type='button')
				svg.nk-i
					use(href='#nk-i-plus')
				label

//- 신 UI 설정 창: 기존 설정 창(#SettingDiag)의 입력 요소를 nk.js가 탭별 줄로 옮겨 씀.
//- 값을 채우는 것·저장(같은 localStorage·쿠키)은 기존 코드 그대로. 기본 UI에서는 열리지 않음
div.dialog.nk-dlg#nk-settings
	div.dialog-head
		div.dialog-title(data-lang-key='settingsText')= L('settingsText')
		div.closeBtn.nk-dlg-close
	div.nk-dlg-body
		nav.nk-dlg-tabs#nk-set-tabs
		div.nk-dlg-panes#nk-set-panes
	div.nk-dlg-foot
		button.nk-btn.ghost#nk-set-server(type='button')
			label(data-lang-key='changeServer')= L('changeServer')
		div.nk-spacer
		button.nk-btn.primary#nk-set-save(type='button')
			label(data-lang-key='save')= L('save')

//- 신 UI 프로필 관리 창: 기존 프로필 관리·글자 조합소·아이템 조합소 창의 내용을 nk.js가 탭으로 옮겨 씀 (처리는 기존 그대로)
div.dialog.nk-dlg#nk-profile
	div.dialog-head
		div.dialog-title(data-lang-key='dress')= L('dress')
		div.closeBtn.nk-dlg-close
	div.nk-dlg-body
		nav.nk-dlg-tabs#nk-pf-tabs
		div.nk-dlg-panes#nk-pf-panes
