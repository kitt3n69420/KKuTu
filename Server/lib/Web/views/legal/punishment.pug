extends ../layout

block CSS
	style.
		.legal-box { line-height: 1.8; word-break: keep-all; }
		.legal-box h1 { margin-bottom: 30px; border-bottom: 2px solid #fff; padding-bottom: 10px; }
		.legal-box h3 { margin-top: 40px; margin-bottom: 15px; font-size: 1.3em; font-weight: bold; color: #81D4FA; }
		.legal-box ul { margin-bottom: 15px; list-style-type: none; padding-left: 10px; }
		.legal-box li { margin-bottom: 8px; color: #ddd; }
		.legal-box a { color: #B3E5FC; }
		.legal-box a:hover { color: #fff; }
		.punishment-card { background: rgba(255,255,255,0.05); border-left: 4px solid #ff9800; border-radius: 6px; padding: 16px 20px; margin-bottom: 16px; }
		.punishment-card .p-date { font-size: 0.85em; color: #aaa; margin-bottom: 10px; }
		.punishment-card .p-user { font-size: 1.05em; font-weight: bold; color: #fff; margin-bottom: 6px; }
		.punishment-card .p-type { display: inline-block; background: #ff9800; color: #fff; border-radius: 4px; padding: 2px 10px; font-size: 0.85em; margin-bottom: 10px; }
		.punishment-card .p-reason { color: #ddd; margin-top: 8px; }
		.punishment-card .p-note { color: #aaa; font-size: 0.9em; font-style: italic; margin-top: 6px; }
		.punishment-card.ban-temp { border-left-color: #ef5350; }
		.punishment-card.ban-temp .p-type { background: #ef5350; }
		.punishment-card.ban-perm { border-left-color: #b71c1c; }
		.punishment-card.ban-perm .p-type { background: #b71c1c; }

