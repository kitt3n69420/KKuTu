extends ../layout

block CSS
	style.
		.legal-box { line-height: 1.8; word-break: keep-all; }
		.legal-box h1 { margin-bottom: 20px; border-bottom: 2px solid #fff; padding-bottom: 10px; }
		.legal-box h3 { margin-top: 40px; margin-bottom: 15px; font-size: 1.3em; font-weight: bold; color: #81D4FA; }
		.legal-box p { margin-bottom: 12px; font-size: 1.05em; color: #eee; }
		.legal-box a { color: #B3E5FC; }
		.legal-box a:hover { color: #fff; }

		.table-wrap { overflow-x: auto; margin-bottom: 20px; }
		.legal-box table { width: 100%; border-collapse: collapse; min-width: 320px; }
		.legal-box th, .legal-box td { border: 1px solid rgba(255,255,255,0.15); padding: 10px 14px; font-size: 0.95em; color: #ddd; text-align: left; }
		.legal-box th { background: rgba(129, 212, 250, 0.12); color: #81D4FA; white-space: nowrap; }
		.legal-box td:first-child { color: #eee; white-space: nowrap; }

block Subject
	title 단어 데이터 출처 안내 - 끄투엔

block Middle
